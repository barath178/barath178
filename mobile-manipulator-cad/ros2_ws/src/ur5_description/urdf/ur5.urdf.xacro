  <link name="grasp_point"/>
  <joint name="world_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="pedestal_link"/>
  </joint>
  <joint name="pedestal_joint" type="fixed">
    <origin xyz="0 0 0.7" rpy="0 0 0"/>
    <parent link="pedestal_link"/>
    <child link="base_link"/>
  </joint>
  <joint name="shoulder_pan_joint" type="revolute">
    <origin xyz="0 0 0.089159" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28319" upper="6.28319" effort="150" velocity="3.15"/>
    <dynamics damping="0.1" friction="0.0"/>
  </joint>
  <joint name="shoulder_lift_joint" type="revolute">
    <origin xyz="0 0.13585 0" rpy="0 1.5708 0"/>
    <parent link="shoulder_link"/>
