    <origin xyz="0.0817 0.021 0" rpy="0 0 0"/>
    <parent link="link5"/>
    <child link="gripper_left_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.01" upper="0.019" effort="1" velocity="4.8"/>
