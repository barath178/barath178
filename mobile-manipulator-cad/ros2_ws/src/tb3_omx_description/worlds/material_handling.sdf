<?xml version="1.0" ?>
<!-- Material-handling cell: work table with payloads, a drop shelf and obstacles.
     UR5 pedestal stands at the origin, the mobile manipulator starts at (1.0, -0.9). -->
<sdf version="1.8">
  <world name="material_handling">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <model name="work_table">
      <static>true</static>
      <pose>0.65 0 0.705 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.6 0.8 0.03</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.6 0.8 0.03</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="work_table_leg_0">
      <static>true</static>
      <pose>0.38 -0.37 0.345 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="work_table_leg_1">
      <static>true</static>
      <pose>0.38 0.37 0.345 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="work_table_leg_2">
      <static>true</static>
      <pose>0.92 -0.37 0.345 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="work_table_leg_3">
      <static>true</static>
      <pose>0.92 0.37 0.345 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.04 0.04 0.69</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.04 0.04 0.69</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="payload_box_1">
      <pose>0.5 -0.2 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>3.000e-05</ixx><iyy>3.000e-05</iyy><izz>3.000e-05</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.8 0.62 0.38 1</ambient><diffuse>0.8 0.62 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="payload_box_2">
      <pose>0.62 0.05 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>3.000e-05</ixx><iyy>3.000e-05</iyy><izz>3.000e-05</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.8 0.62 0.38 1</ambient><diffuse>0.8 0.62 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="payload_box_3">
      <pose>0.75 0.22 0.75 0 0 0</pose>
      <link name="link">
        <inertial><mass>0.05</mass><inertia><ixx>3.000e-05</ixx><iyy>3.000e-05</iyy><izz>3.000e-05</izz></inertia></inertial>
        <collision name="c"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision>
        <visual name="v"><geometry><box><size>0.06 0.06 0.06</size></box></geometry>
          <material><ambient>0.8 0.62 0.38 1</ambient><diffuse>0.8 0.62 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="obstacle_column">
      <static>true</static>
      <pose>0.4 0.65 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.12 0.12 1</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.12 0.12 1</size></box></geometry>
          <material><ambient>0.9 0.45 0.1 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drop_shelf">
      <static>true</static>
      <pose>1.5 0 0.21 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.5 0.02</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.5 0.02</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
      </link>
    </model>
    <model name="drop_shelf_leg_0">
      <static>true</static>
      <pose>1.31 -0.24 0.1 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.02 0.02 0.2</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.02 0.02 0.2</size></box></geometry>
          <material><ambient>0.72 0.56 0.38 1</ambient><diffuse>0.72 0.56 0.38 1</diffuse></material></visual>
